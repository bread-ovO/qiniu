{
  "name": "ai-pr-review-bot",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub App that reviews pull requests with OpenAI-assisted analysis.",
  "type": "module",
  "scripts": {
    "dev": "tsx ./node_modules/probot/bin/probot.js run ./src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "probot run ./dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "openai": "^4.104.0",
    "probot": "^14.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20"
  }
}
